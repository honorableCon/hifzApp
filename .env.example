NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://hifzapp:hifzapp@localhost:5432/hifzapp?schema=public"

# Redis-compatible cache / queue backend
REDIS_URL="redis://localhost:6379"

# Auth/session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-characters"

# Optional object storage for audio/offline assets
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
